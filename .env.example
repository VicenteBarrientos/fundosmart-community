# Configuración no secreta para desarrollo y build.
NEXT_PUBLIC_APP_URL=http://localhost:3000
FUNDOSMART_DEPLOY_ENVIRONMENT=development
FUNDOSMART_WORKER_NAME=fundosmart-community
FUNDOSMART_D1_DATABASE_NAME=fundosmart-community-local
FUNDOSMART_R2_BUCKET_NAME=fundosmart-community-files
FUNDOSMART_DATA_JURISDICTION=
FUNDOSMART_ENABLE_AI=false
FUNDOSMART_ENABLE_REMOTE_AI=false
FUNDOSMART_ENABLE_ANALYTICS=false

