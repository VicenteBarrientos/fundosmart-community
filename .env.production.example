# Copia este archivo como .env.staging.local o .env.production.local y reemplaza todos los valores.
# Las herramientas self-host cargan e inyectan la copia seleccionada; el preflight falla cerrado
# ante placeholders, recursos locales, orígenes divergentes o un SHA incorrecto.
NEXT_PUBLIC_APP_URL=https://replace.invalid
FUNDOSMART_BASE_URL=https://replace.invalid
FUNDOSMART_APP_BASE_URL=https://replace.invalid
FUNDOSMART_DEPLOY_ENVIRONMENT=production
FUNDOSMART_RELEASE_SHA=<full-git-commit-sha>
FUNDOSMART_WORKER_NAME=fundosmart-community-selfhost
FUNDOSMART_D1_DATABASE_NAME=fundosmart-community-selfhost
FUNDOSMART_D1_DATABASE_ID=<d1-database-uuid>
FUNDOSMART_R2_BUCKET_NAME=fundosmart-community-selfhost-files
# Opcional: vacío (jurisdicción predeterminada), eu o fedramp.
FUNDOSMART_DATA_JURISDICTION=
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>

# Integraciones opcionales. Todos estos valores se incorporan durante el build.
FUNDOSMART_ENABLE_AI=false
FUNDOSMART_ENABLE_REMOTE_AI=false
FUNDOSMART_ENABLE_ANALYTICS=false
# FUNDOSMART_METRICS_DATASET=fundosmart_community_metrics
# FUNDOSMART_MAP_USAGE_DATASET=fundosmart_community_map_usage
# FUNDOSMART_EMAIL_FROM=notifications@tu-dominio.cl
# FUNDOSMART_INBOX_DOMAIN=inbox.tu-dominio.cl
# NEXT_PUBLIC_ARCGIS_BASEMAP_KEY=
