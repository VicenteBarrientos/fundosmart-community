# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*
!.env.example
!.env.production.example
!.dev.vars.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
.wrangler/
/output/
/outputs/
/tmp/
/work/

# local tooling
/.claude/
/.codex/
/.codex-task.json
