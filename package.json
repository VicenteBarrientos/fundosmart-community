{
  "name": "fundosmart-community",
  "version": "0.2.0",
  "description": "Plataforma open source para la gestión agrícola, ganadera y lechera.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/VicenteBarrientos/fundosmart-community#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VicenteBarrientos/fundosmart-community.git"
  },
  "bugs": {
    "url": "https://github.com/VicenteBarrientos/fundosmart-community/issues"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:favicon": "node scripts/assets/generate-favicon.mjs",
    "dev:init": "node scripts/development/create-local-vars.mjs",
    "predev": "npm run db:migrate:local",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "node scripts/release/direct-deploy-blocked.mjs",
    "deploy:check": "npm run build && npm run deploy:check:built",
    "deploy:check:built": "wrangler deploy --dry-run --outdir .wrangler/deploy-check -c dist/server/wrangler.json",
    "self-host:init-secrets": "node scripts/release/create-self-hosting-secrets.mjs",
    "self-host:validate": "node scripts/release/self-hosting-preflight.mjs",
    "self-host:check": "node scripts/release/run-self-hosting-check.mjs",
    "self-host:verify:built": "node scripts/release/self-hosting-preflight.mjs --built",
    "self-host:wrangler": "node scripts/release/run-pinned-wrangler.mjs",
    "self-host:smoke": "node scripts/release/smoke.mjs",
    "sbom:generate": "node scripts/release/generate-sbom.mjs --write",
    "sbom:check": "node scripts/release/generate-sbom.mjs --check",
    "recovery:check": "npm run build && npm run recovery:check:built",
    "recovery:check:built": "node scripts/recovery/verify-isolated.mjs",
    "types:worker": "npm run build && wrangler types worker-configuration.d.ts --include-runtime false -c dist/server/wrangler.json",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test --test-concurrency=4",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:built && npm run deploy:check:built && npm run sbom:check && npm audit",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap:generate": "node scripts/data/generate-public-demo-migration.mjs",
    "db:migrations:local": "wrangler d1 migrations list DB --local --persist-to .wrangler/state -c scripts/development/wrangler.local-d1.jsonc",
    "db:migrate:local": "cross-env CI=true wrangler d1 migrations apply DB --local --persist-to .wrangler/state -c scripts/development/wrangler.local-d1.jsonc",
    "db:repair:local": "node scripts/development/repair-local-d1.mjs"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "@turf/area": "^7.3.5",
    "@turf/boolean-within": "^7.3.5",
    "@turf/buffer": "^7.3.5",
    "@turf/difference": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/intersect": "^7.3.5",
    "@turf/kinks": "^7.3.5",
    "@turf/length": "^7.3.5",
    "@turf/simplify": "^7.3.5",
    "@turf/union": "^7.3.5",
    "@xmldom/xmldom": "^0.9.10",
    "drizzle-orm": "0.45.2",
    "esri-leaflet-vector": "4.3.2",
    "jose": "^6.2.4",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "4.7.1",
    "next": "16.4.0",
    "proj4": "^2.20.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/workers-types": "5.20260724.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "brace-expansion": "file:vendor/brace-expansion-compat",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "minimatch": "3.1.5",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "@babel/core": "8.0.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "brace-expansion": "$brace-expansion",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "type": "module"
}
