  leaseExpiresAt: null;
  objectCursorImportJobId: null;
  copiedObjectCount: 0;
  compensationCursorImportJobId: null;
  compensatedObjectCount: 0;
  appliedRowCount: 0;
  verifiedRowCount: 0;
  preRestoreBackupObjectKey: null;
  preRestoreBackupSha256: null;
  postRestoreSha256: null;
  failureCode: null;
  preparedAt: string;
  createdAt: string;
  updatedAt: string;
